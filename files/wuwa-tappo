#!/usr/bin/env bash
# Wuwa Tappo（Windows 版 Tauri/WebView2 桌寵）的 Linux 啟動器，透過 GE-Proton 的 Wine 執行。
#
#   wuwa-tappo                     啟動已安裝的 Wuwa Tappo
#   wuwa-tappo install <setup.exe> 執行官方安裝程式
#   wuwa-tappo setup               建立 Wine prefix、安裝 WebView2 Runtime 等
#   wuwa-tappo kill                結束桌寵與所有輔助程式
#   wuwa-tappo wine <args...>      在此 prefix 內執行任意 wine 指令
#
# 環境變數：WUWA_TAPPO_HOME（安裝目錄）、WUWA_WINE_DIR（指定 wine 的 bin 目錄）、
#           WUWA_KEY_FORWARD=0（關閉鍵盤/滑鼠轉送）、WUWA_ALPHA_MIRROR=0（關閉透明覆蓋）
set -euo pipefail

BASE="${WUWA_TAPPO_HOME:-$HOME/.local/share/wuwa-tappo}"
export WINEPREFIX="$BASE/prefix"

# --- 選擇 Wine：WebView2 (Edge 15x) 需要 Wine >= 10，發行版內建的舊 wine 會崩潰 ---
find_wine_bin() {
    if [[ -n "${WUWA_WINE_DIR:-}" ]]; then echo "$WUWA_WINE_DIR"; return; fi
    local d
    for d in \
        $(ls -d "$BASE"/proton/GE-Proton*/files/bin 2>/dev/null | sort -Vr) \
        "$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-6-x86_64/files/bin" \
        $(ls -d "$HOME"/.local/share/Steam/compatibilitytools.d/GE-Proton1[0-9]*/files/bin 2>/dev/null | sort -Vr) \
        $(ls -d "$HOME"/.steam/root/compatibilitytools.d/GE-Proton1[0-9]*/files/bin 2>/dev/null | sort -Vr); do
        [[ -x "$d/wine" ]] && { echo "$d"; return; }
    done
    echo "找不到 GE-Proton (>=10)。請重新執行 install.sh，或設定 WUWA_WINE_DIR 指向含 wine 的 bin 目錄。" >&2
    exit 1
}
WINE_BIN="$(find_wine_bin)"
export PATH="$WINE_BIN:$PATH"

export WINEDEBUG="${WINEDEBUG:--all}"
# 不讓 Wine 自動產生（指向錯誤 wine 的）.desktop 捷徑
export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
# WebView2 (Chromium) 在 Wine 下需要關閉 sandbox 與 GPU 加速
export WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="${WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS:---no-sandbox --disable-gpu}"
export WUWA_TAPPO_HOME="$BASE"

KEY_PORT="${WUWA_KEY_PORT:-47811}"
WEBVIEW2_URL="https://go.microsoft.com/fwlink/?linkid=2124701"
WINPYTHON_URL="https://www.python.org/ftp/python/3.12.10/python-3.12.10-embed-amd64.zip"
APP_PATTERN='Program Files.WuwaTappo.WuwaTappo\.exe'

# Proton 的 wined3d/dxgi 依賴 vkd3d DLL；Proton 自己的啟動腳本會把它們複製進 prefix，
# 我們直接呼叫 wine，所以要自己補上（否則主程式匯入 dxgi.dll 失敗，exit code 53）
ensure_vkd3d() {
    local src="$WINE_BIN/../lib/vkd3d" arch dst f
    for arch in "x86_64-windows:system32" "i386-windows:syswow64"; do
        dst="$WINEPREFIX/drive_c/windows/${arch#*:}"
        [[ -d "$dst" && -d "$src/${arch%%:*}" ]] || continue
        for f in "$src/${arch%%:*}"/*.dll; do
            cmp -s "$f" "$dst/$(basename "$f")" || cp -f "$f" "$dst/"
        done
    done
}

find_app() {
    find "$WINEPREFIX/drive_c" -iname 'WuwaTappo.exe' \
        -not -path '*/Temp/*' -not -path '*/EdgeWebView/*' 2>/dev/null | head -n1
}

# 只結束「這個安裝目錄」的輔助程式（以完整路徑比對，避免誤殺其他安裝的同名程式）
kill_helpers() {
    local linux_path="$BASE/helpers/" win_path="${BASE//\//\\}\\helpers\\"
    ps -eo pid=,args= | while read -r pid args; do
        case "$args" in
            "python3 -I $linux_path"*|*"$win_path"key_injector.py*) kill "$pid" 2>/dev/null || true ;;
        esac
    done
}

# 從已安裝的 exe 取出圖示給選單捷徑用（需要 7z，沒有就略過）
ensure_icon() {
    [[ -f "$BASE/icon.png" ]] && return
    command -v 7z >/dev/null || return 0
    local tmp; tmp="$(mktemp -d)"
    if 7z x -y -o"$tmp" "$1" '.rsrc/ICON/*' >/dev/null 2>&1; then
        local best; best="$(ls -S "$tmp"/.rsrc/ICON/* 2>/dev/null | head -n1)"
        [[ -n "$best" ]] && file -b "$best" | grep -q PNG && cp "$best" "$BASE/icon.png"
    fi
    rm -rf "$tmp"
}

do_setup() {
    mkdir -p "$BASE/downloads"
    if [[ ! -f "$WINEPREFIX/system.reg" ]]; then
        echo "==> 建立 Wine prefix: $WINEPREFIX"
        WINEDLLOVERRIDES="$WINEDLLOVERRIDES;mscoree,mshtml=" wine wineboot -i
    fi
    if ! ls "$WINEPREFIX/drive_c/Program Files (x86)/Microsoft/EdgeWebView/Application/"*/msedgewebview2.exe >/dev/null 2>&1; then
        local inst="$BASE/downloads/MicrosoftEdgeWebView2RuntimeInstallerX64.exe"
        [[ -f "$inst" ]] || { echo "==> 下載 WebView2 Runtime（約 200 MB）"; curl -fL -o "$inst" "$WEBVIEW2_URL"; }
        echo "==> 安裝 WebView2 Runtime（約 1-2 分鐘）"
        wine "$inst" /silent /install || true
        ls "$WINEPREFIX/drive_c/Program Files (x86)/Microsoft/EdgeWebView/Application/"*/msedgewebview2.exe >/dev/null 2>&1 \
            || { echo "WebView2 Runtime 安裝失敗" >&2; exit 1; }
    fi
    # Wine 端的輸入轉送程式需要 Windows 版 Python（官方免安裝版）
    if [[ ! -f "$BASE/winpython/python.exe" ]]; then
        local zip="$BASE/downloads/python-embed-amd64.zip"
        [[ -f "$zip" ]] || { echo "==> 下載 Windows 版 Python（約 11 MB）"; curl -fL -o "$zip" "$WINPYTHON_URL"; }
        mkdir -p "$BASE/winpython"
        python3 -I -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "$zip" "$BASE/winpython"
    fi
    echo "==> 環境準備完成"
}

cmd="${1:-run}"
case "$cmd" in
    setup)   do_setup ;;
    install)
        shift
        exe="${1:?用法: wuwa-tappo install /path/to/WuwaTappo-xx_setup.exe}"
        exe="$(realpath "$exe")"
        [[ -f "$WINEPREFIX/system.reg" && -f "$BASE/winpython/python.exe" ]] || do_setup
        ensure_vkd3d
        # 安裝程式本身也是 Tauri 程式，有同樣的 RevokeDragDrop 崩潰（時序競爭，偶發）。
        # 複製一份到 downloads 再套用修補，不動使用者的原始檔。
        mkdir -p "$BASE/downloads"
        patched="$BASE/downloads/$(basename "$exe" .exe)-linux.exe"
        cp -f "$exe" "$patched"
        python3 -I "$BASE/patch_dragdrop.py" "$patched" && rm -f "$patched.orig" || patched="$exe"
        exe="$patched"
        # 修補後理論上不會再崩潰；保留重試以防萬一
        for attempt in 1 2 3; do
            start=$SECONDS; rc=0
            wine "$exe" || rc=$?
            if [[ $rc -eq 5 && $((SECONDS - start)) -lt 20 && $attempt -lt 3 ]]; then
                echo "==> 安裝程式啟動失敗（exit 5），5 秒後重試…" >&2; sleep 5; continue
            fi
            break
        done
        [[ "$exe" == "$BASE/downloads/"*-linux.exe ]] && rm -f "$exe"
        app="$(find_app)"; [[ -n "$app" ]] && ensure_icon "$app"
        exit "$rc"
        ;;
    kill)    kill_helpers; wineserver -k || true ;;
    wine)    shift; exec wine "$@" ;;
    run)
        app="$(find_app)"
        if [[ -z "$app" ]]; then
            echo "尚未安裝 Wuwa Tappo。請先執行: wuwa-tappo install <setup.exe>" >&2
            exit 1
        fi
        ensure_vkd3d
        ensure_icon "$app"
        # 繞過 Wine 的 RevokeDragDrop 跨行程崩潰（程式更新後也會自動重新套用）
        python3 -I "$BASE/patch_dragdrop.py" "$app" || true
        cd "$(dirname "$app")"
        # 已在執行（單一實例）→ 直接交給既有實例，不重複啟動輔助程式
        if pgrep -f "$APP_PATTERN" >/dev/null; then
            exec wine "$app" "${@:2}"
        fi
        kill_helpers  # 清掉上次異常結束留下的輔助程式
        wine "$app" "${@:2}" &
        app_pid=$!
        helper_pids=()
        # 讓桌寵偵測在 Linux 原生程式中的打字與點擊（Wine 只收得到自己視窗的輸入）
        if [[ "${WUWA_KEY_FORWARD:-1}" == 1 && -f "$BASE/winpython/python.exe" ]]; then
            wine "$BASE/winpython/python.exe" "Z:${BASE//\//\\}\\helpers\\key_injector.py" "$KEY_PORT" &
            helper_pids+=($!)
            python3 -I "$BASE/helpers/key_forwarder.py" "$KEY_PORT" &
            helper_pids+=($!)
        fi
        # 透明背景、寶箱重繪、點擊層置頂等（詳見 helpers/alpha_mirror.py）
        if [[ "${WUWA_ALPHA_MIRROR:-1}" == 1 ]]; then
            python3 -I "$BASE/helpers/alpha_mirror.py" "$KEY_PORT" &
            helper_pids+=($!)
        fi
        cleanup() { kill "${helper_pids[@]}" 2>/dev/null || true; kill_helpers; }
        trap 'cleanup; kill "$app_pid" 2>/dev/null' INT TERM
        wait "$app_pid" || rc=$?
        cleanup
        exit "${rc:-0}"
        ;;
    *) sed -n '2,11p' "$0"; exit 1 ;;
esac
